MONGO_USER=radar
MONGO_PASSWORD=change-me-to-a-long-random-string

# Optional: Reddit OAuth (reddit.com/prefs/apps -> "create app" -> type "script").
# Without these, Reddit usually answers 403 and that source is skipped.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=

# Optional: Brave Search API key, used to find recent Reddit posts without Reddit API access.
# Free monthly credit covers this easily (~120 searches/month).
BRAVE_API_KEY=
